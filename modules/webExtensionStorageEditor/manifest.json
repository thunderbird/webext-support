{
    "manifest_version": 2,
    "name": "WebExtension Storage Editor Example",
    "version": "1.0",
    "description": "Showcase the WebExtension storage editor.",
    "browser_specific_settings": {
        "gecko": {
            "id": "webExtensionStorageEditor@example.thunderbird.net",
            "strict_min_version": "91.0"
        }
    },
    "permissions": [
        "storage"
    ],
    "browser_action": {
        "default_title": "Edit WebExtension Storage"
    },
    "content_security_policy": "script-src 'self' 'sha256-pSeZqbIND286+J0FQz+c0m4YoKTRwH/II6GyU3ZM6As=';",
    "background": {
        "scripts": [
            "background.js"
        ],
        "type": "module"
    }
}